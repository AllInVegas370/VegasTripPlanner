<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-background-color: #FFFBF7;" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/25.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="finalproject.vegastripplanner.AccountController">
   <top>
      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <Region prefHeight="100.0" prefWidth="154.0" HBox.hgrow="ALWAYS" />
            <Label alignment="CENTER" prefHeight="71.0" prefWidth="376.0" text="Welcome to All In Vegas!">
               <font>
                  <Font name="Impact" size="32.0" />
               </font>
               <HBox.margin>
                  <Insets left="20.0" right="140.0" top="50.0" />
               </HBox.margin>
            </Label>
            <Region prefHeight="100.0" prefWidth="47.0" HBox.hgrow="ALWAYS" />
         </children></HBox>
   </top>
   <center>
      <VBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" BorderPane.alignment="CENTER">
         <children>
            <Region prefHeight="17.0" prefWidth="644.0" />
            <Label text="Please enter your first name:">
               <font>
                  <Font name="Impact" size="20.0" />
               </font>
            </Label>
            <TextField alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="26.0" prefWidth="203.0" promptText="first name" />
            <Label text="Please enter your birthday:">
               <font>
                  <Font name="Impact" size="20.0" />
               </font>
            </Label>
            <DatePicker />
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Please enter a username:">
               <font>
                  <Font name="Impact" size="20.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin>
            </Label>
            <TextField fx:id="usernameField" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="26.0" prefWidth="199.0" promptText="username" stylesheets="@style.css">
               <VBox.margin>
                  <Insets bottom="20.0" left="5.0" />
               </VBox.margin>
            </TextField>
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Please enter a password:">
               <font>
                  <Font name="Impact" size="20.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin>
            </Label>
            <PasswordField fx:id="passwordField" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="26.0" prefWidth="199.0" promptText="password" />
            <Region prefHeight="49.0" prefWidth="644.0" />
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox prefHeight="201.0" prefWidth="644.0" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
