<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="900.0" prefWidth="1440.0" styleClass="login-root" stylesheets="@login.css" xmlns="http://javafx.com/javafx/25.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="finalproject.vegastripplanner.MainController">
   <center>
      <GridPane>
         <columnConstraints>
            <ColumnConstraints percentWidth="53.0" />
            <ColumnConstraints percentWidth="47.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints vgrow="ALWAYS" />
         </rowConstraints>
         <children>

            <!-- LEFT: Vegas photo panel -->
            <StackPane styleClass="hero" GridPane.columnIndex="0">
               <children>
                  <Region styleClass="hero-overlay" />
                  <VBox spacing="0.0">
                     <padding>
                        <Insets bottom="57.0" left="48.0" right="48.0" top="45.0" />
                     </padding>
                     <children>
                        <HBox alignment="TOP_LEFT">
                           <children>
                              <VBox spacing="6.0">
                                 <children>
                                    <Label styleClass="brand-name" text="ALL IN VEGAS" />
                                    <Label styleClass="brand-tagline" text="YOUR TRIP. YOUR VEGAS." />
                                 </children>
                              </VBox>
                              <Region HBox.hgrow="ALWAYS" />
                              <Label styleClass="destination-badge" text="LAS VEGAS, NEVADA" />
                           </children>
                        </HBox>
                        <Region VBox.vgrow="ALWAYS" />
                        <Label styleClass="hero-eyebrow" text="LESS PLANNING. MORE LIVING." />
                        <Label styleClass="hero-title" text="Go all in.&#10;Make it your Vegas.">
                           <VBox.margin>
                              <Insets top="20.0" />
                           </VBox.margin>
                        </Label>
                        <Label styleClass="hero-description" text="The tables. The tastes. The unforgettable nights.&#10;Bring it all together in one extraordinary trip.">
                           <VBox.margin>
                              <Insets top="28.0" />
                           </VBox.margin>
                        </Label>
                        <Region maxHeight="1.0" minHeight="1.0" prefHeight="1.0" styleClass="hero-rule">
                           <VBox.margin>
                              <Insets top="48.0" />
                           </VBox.margin>
                        </Region>
                        <Label styleClass="hero-footer-text" text="STAYS  /  DINING  /  SHOWS  /  NIGHTLIFE">
                           <VBox.margin>
                              <Insets top="24.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </StackPane>

            <!-- RIGHT: sign-in panel -->
            <VBox alignment="TOP_CENTER" styleClass="auth-panel" GridPane.columnIndex="1">
               <padding>
                  <Insets bottom="46.0" left="40.0" right="40.0" top="48.0" />
               </padding>
               <children>

                  <!-- header row -->
                  <HBox alignment="CENTER_LEFT" maxWidth="456.0">
                     <children>
                        <Label styleClass="auth-note" text="A LITTLE PLANNING. A LOT OF VEGAS." />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="quitButton" mnemonicParsing="false" onAction="#onQuitButtonClicked" styleClass="link-button" text="Quit" />
                     </children>
                  </HBox>

                  <Region VBox.vgrow="ALWAYS" />

                  <!-- form -->
                  <VBox maxWidth="456.0" spacing="24.0">
                     <children>
                        <VBox spacing="12.0">
                           <children>
                              <Label styleClass="form-eyebrow" text="YOUR VEGAS STARTS HERE" />
                              <Label fx:id="welcomeLabel" styleClass="form-title" text="Welcome back." />
                              <Label styleClass="form-description" text="Big nights. Great plans. Pick up where you left off." />
                           </children>
                        </VBox>

                        <VBox spacing="18.0">
                           <children>
                              <VBox spacing="8.0">
                                 <children>
                                    <Label styleClass="field-label" text="Username" />
                                    <TextField fx:id="usernameLabel" promptText="Enter your username" />
                                 </children>
                              </VBox>
                              <VBox spacing="8.0">
                                 <children>
                                    <Label styleClass="field-label" text="Password" />
                                    <PasswordField fx:id="passwordLabel" promptText="Enter your password" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <CheckBox fx:id="rememberMeCheck" mnemonicParsing="false" text="Remember me" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label styleClass="forgot-password" text="Forgot password?" />
                           </children>
                        </HBox>

                        <Button fx:id="signInButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onSignInButtonClicked"  styleClass="primary-button" text="Sign in" />

                        <HBox alignment="CENTER" spacing="16.0">
                           <children>
                              <Region maxHeight="1.0" minHeight="1.0" prefHeight="1.0" styleClass="divider-line" HBox.hgrow="ALWAYS" />
                              <Label styleClass="divider-text" text="First time in? Make it a trip." />
                              <Region maxHeight="1.0" minHeight="1.0" prefHeight="1.0" styleClass="divider-line" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>

                        <Button fx:id="createAccountButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onCreateAccountButtonClicked" styleClass="secondary-button" text="Create an account" />

                        <!-- kept so your existing navigation still works; delete once login is wired up -->
                        <HBox spacing="12.0">
                           <children>
                              <Button fx:id="planTrpButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onPlanTripButtonClicked" styleClass="secondary-button" text="Plan a Trip" HBox.hgrow="ALWAYS" />
                              <Button fx:id="exploreButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onExploreButtonClicked" styleClass="secondary-button" text="Explore Your Options" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <Region VBox.vgrow="ALWAYS" />

                  <!-- footer -->
                  <VBox alignment="CENTER" maxWidth="456.0" spacing="14.0">
                     <children>
                        <Label styleClass="footer-text" text="By continuing, you agree to our Terms of Service and Privacy Policy." />
                        <Label styleClass="footer-text" text="© 2026 All In Vegas. Make every moment count." />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </GridPane>
   </center>
</BorderPane>
