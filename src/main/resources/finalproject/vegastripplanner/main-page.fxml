<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="633.0" prefWidth="742.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="finalproject.vegastripplanner.MainController">
   <bottom>
      <StackPane prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Button fx:id="planTrpButton" alignment="CENTER" mnemonicParsing="false" onAction="#onPlanTripButtonClicked" prefHeight="81.0" prefWidth="123.0" style="-fx-background-radius: 20px;" text="Planning a Trip?" HBox.hgrow="NEVER">
                     <HBox.margin>
                        <Insets left="100.0" />
                     </HBox.margin>
                  </Button>
                  <Region prefHeight="150.0" prefWidth="136.0" HBox.hgrow="ALWAYS" />
                  <Button fx:id="exploreButton" alignment="CENTER" mnemonicParsing="false" onAction="#onExploreButtonClicked" prefHeight="87.0" prefWidth="124.0" style="-fx-background-radius: 20;" text="Exploring" HBox.hgrow="NEVER">
                     <HBox.margin>
                        <Insets left="200.0" right="100.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
         </children>
      </StackPane>
   </bottom>
   <top>
      <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="quitButton" mnemonicParsing="false" onAction="#onQuitButtonClicked" prefHeight="34.0" prefWidth="56.0" style="-fx-background-radius: 20;" text="Quit">
               <HBox.margin>
                  <Insets left="5.0" top="10.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="30.0" prefWidth="30.0" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" text="Welcome!" textAlignment="CENTER" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets left="10.0" />
               </VBox.margin>
               <font>
                  <Font name="Impact" size="25.0" />
               </font>
            </Label>
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" prefHeight="17.0" prefWidth="619.0" text="Please enter your username and password:">
               <VBox.margin>
                  <Insets left="10.0" top="100.0" />
               </VBox.margin>
               <font>
                  <Font name="Impact" size="19.0" />
               </font>
            </Label>
            <TextField alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="25.0" prefWidth="225.0" promptText="username">
               <VBox.margin>
                  <Insets bottom="10.0" left="220.0" right="200.0" top="100.0" />
               </VBox.margin>
            </TextField>
            <TextField alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="25.0" prefWidth="223.0" promptText="password">
               <VBox.margin>
                  <Insets left="220.0" right="200.0" />
               </VBox.margin>
            </TextField>
         </children>
      </VBox>
   </center>
</BorderPane>
