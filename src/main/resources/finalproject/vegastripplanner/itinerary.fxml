<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Itinerary page: your trips (left), the selected trip day by day (middle), your favorites (right).
     The day-by-day rows are built in ItineraryController, so the middle column is just an empty VBox here. -->
<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="900.0" prefWidth="1440.0" styleClass="browse-root" stylesheets="@browse.css" xmlns="http://javafx.com/javafx/25.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="finalproject.vegastripplanner.ItineraryController">

   <!-- HEADER: brand + navigation -->
   <top>
      <VBox>
         <padding>
            <Insets left="48.0" right="48.0" top="30.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" styleClass="page-header">
               <children>
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="brand-name-dark" text="ALL IN VEGAS" />
                        <Label styleClass="brand-tagline-dark" text="YOUR TRIP. YOUR VEGAS." />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER_RIGHT" spacing="12.0">
                     <children>
                        <Button mnemonicParsing="false" styleClass="nav-button-active" text="Your Itinerary" />
                        <Button fx:id="back" mnemonicParsing="false" onAction="#onReturnButtonClicked" styleClass="nav-button" text="Browse places" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <!-- MAIN CONTENT -->
   <center>
      <HBox spacing="22.0">
         <padding>
            <Insets bottom="30.0" left="48.0" right="48.0" top="24.0" />
         </padding>
         <children>

            <!-- trips -->
            <VBox minWidth="280.0" prefWidth="300.0" spacing="12.0" styleClass="detail-panel">
               <padding>
                  <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
               </padding>
               <children>
                  <Label styleClass="section-title" text="My trips" />
                  <Label styleClass="section-hint" text="Pick a trip to see its plan." />
                  <ListView fx:id="tripsList" VBox.vgrow="ALWAYS" />
                  <HBox spacing="10.0">
                     <children>
                        <Button fx:id="newTripButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNewTripClicked" prefWidth="0.0" styleClass="primary-button" text="New trip" HBox.hgrow="ALWAYS" />
                        <Button fx:id="deleteTripButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onDeleteTripClicked" prefWidth="0.0" styleClass="secondary-button" text="Delete trip" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- selected trip, day by day -->
            <VBox spacing="10.0" styleClass="detail-panel" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="18.0" left="22.0" right="22.0" top="18.0" />
               </padding>
               <children>
                  <Label fx:id="tripTitle" styleClass="detail-title" text="Your itinerary" wrapText="true" />
                  <Label fx:id="tripDates" styleClass="section-hint" text="" />
                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="detail-scroll" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="daysBox" spacing="10.0" />
                     </content>
                  </ScrollPane>
               </children>
            </VBox>

            <!-- favorites -->
            <VBox minWidth="300.0" prefWidth="320.0" spacing="12.0" styleClass="detail-panel">
               <padding>
                  <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
               </padding>
               <children>
                  <Label styleClass="section-title" text="Favorites" />
                  <Label styleClass="section-hint" text="Add a favorite to the selected trip (day 1)." wrapText="true" />
                  <ListView fx:id="favoritesList" VBox.vgrow="ALWAYS" />
                  <HBox spacing="10.0">
                     <children>
                        <Button fx:id="addFavoriteButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAddFavoriteToTripClicked" prefWidth="0.0" styleClass="primary-button" text="Add to trip" HBox.hgrow="ALWAYS" />
                        <Button fx:id="removeFavoriteButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onRemoveFavoriteClicked" prefWidth="0.0" styleClass="secondary-button" text="Remove" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>

         </children>
      </HBox>
   </center>
</BorderPane>
