<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="500.0" prefWidth="600.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="finalproject.vegastripplanner.PlanningTripController">
   <top>
      <HBox prefHeight="104.0" prefWidth="600.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="quitButton" mnemonicParsing="false" onAction="#onQuitButtonClicked" prefHeight="40.0" prefWidth="72.0" style="-fx-background-radius: 20;" text="Quit">
               <HBox.margin>
                  <Insets left="10.0" top="10.0" />
               </HBox.margin>
               <font>
                  <Font name="Impact" size="13.0" />
               </font>
            </Button>
            <Button fx:id="returnButton" mnemonicParsing="false" onAction="#onReturnButtonClicked" prefHeight="39.0" prefWidth="85.0" style="-fx-background-radius: 20;" text="Return">
               <HBox.margin>
                  <Insets left="5.0" top="10.0" />
               </HBox.margin>
               <font>
                  <Font name="Impact" size="13.0" />
               </font>
            </Button>
            <Region prefHeight="100.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />
            <Label prefHeight="66.0" prefWidth="286.0" text="Plan a Trip!" textAlignment="CENTER">
               <font>
                  <Font name="Impact" size="53.0" />
               </font>
               <HBox.margin>
                  <Insets left="50.0" right="150.0" top="15.0" />
               </HBox.margin>
            </Label>
            <Region prefHeight="100.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </top>
   <left>
      <VBox prefHeight="396.0" prefWidth="216.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="What is your budget?">
               <VBox.margin>
                  <Insets bottom="5.0" left="10.0" />
               </VBox.margin></Label>
            <ChoiceBox fx:id="budget" prefWidth="150.0">
               <VBox.margin>
                  <Insets left="10.0" />
               </VBox.margin></ChoiceBox>
            <Label text="How many children are in your party?">
               <VBox.margin>
                  <Insets bottom="5.0" left="10.0" top="10.0" />
               </VBox.margin></Label>
            <ChoiceBox fx:id="children" prefWidth="150.0">
               <VBox.margin>
                  <Insets left="10.0" />
               </VBox.margin></ChoiceBox>
            <Label text="How many adults are in your paty?">
               <VBox.margin>
                  <Insets bottom="5.0" left="10.0" top="10.0" />
               </VBox.margin>
            </Label>
            <ChoiceBox fx:id="adults" prefWidth="150.0">
               <VBox.margin>
                  <Insets left="10.0" />
               </VBox.margin>
            </ChoiceBox>
            <Label text="What are your interests?">
               <VBox.margin>
                  <Insets bottom="5.0" left="10.0" top="10.0" />
               </VBox.margin>
            </Label>
            <ChoiceBox fx:id="interests" prefWidth="150.0">
               <VBox.margin>
                  <Insets left="10.0" />
               </VBox.margin>
            </ChoiceBox>
         </children>
      </VBox>
   </left>
   <right>
      <VBox prefHeight="396.0" prefWidth="194.0" BorderPane.alignment="CENTER" />
   </right>
   <center>
      <VBox prefHeight="378.0" prefWidth="144.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Please enter your start date:">
               <VBox.margin>
                  <Insets bottom="5.0" left="10.0" />
               </VBox.margin></Label>
            <DatePicker promptText="MM/DD/YYYY">
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" />
               </VBox.margin></DatePicker>
            <Label text="Please enter your end date:">
               <VBox.margin>
                  <Insets bottom="5.0" left="10.0" />
               </VBox.margin></Label>
            <DatePicker promptText="MM/DD/YYYY">
               <VBox.margin>
                  <Insets left="10.0" />
               </VBox.margin></DatePicker>
         </children>
      </VBox>
   </center>
</BorderPane>
