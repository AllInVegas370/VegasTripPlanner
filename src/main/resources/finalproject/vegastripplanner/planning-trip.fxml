<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="900.0" prefWidth="1440.0" styleClass="aiv-page" xmlns="http://javafx.com/javafx/25.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="finalproject.vegastripplanner.PlanningTripController">
   <stylesheets>
      <URL value="@theme.css" />
      <URL value="@planning.css" />
   </stylesheets>

   <!-- HEADER -->
   <top>
      <VBox>
         <padding>
            <Insets left="48.0" right="48.0" top="30.0" />
         </padding>
         <children>
            <HBox alignment="TOP_LEFT" styleClass="aiv-nav">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label styleClass="aiv-brand" text="ALL IN VEGAS" />
                        <Label styleClass="aiv-brand-tagline" text="YOUR TRIP. YOUR VEGAS." />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER_RIGHT" spacing="40.0">
                     <children>
                        <!-- shown by AccountController right after sign-up -->
                        <Label fx:id="accountCreatedLabel" managed="false" styleClass="prefs-status" text="✓  ACCOUNT CREATED" visible="false" />
                        <Button fx:id="returnButton" mnemonicParsing="false" onAction="#onReturnButtonClicked" styleClass="prefs-header-link" text="← Back" />
                        <Button fx:id="quitButton" mnemonicParsing="false" onAction="#onQuitButtonClicked" styleClass="prefs-header-link" text="Quit" />
                     </children>
                     <padding>
                        <Insets top="6.0" />
                     </padding>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <!-- MAIN FORM -->
   <center>
      <VBox alignment="TOP_CENTER">
         <padding>
            <Insets left="48.0" right="48.0" top="38.0" />
         </padding>
         <children>
            <VBox maxWidth="960.0" spacing="28.0">
               <children>

                  <!-- intro -->
                  <VBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Label styleClass="aiv-eyebrow" text="A LITTLE YOU. A LOT OF VEGAS." />
                        <Label styleClass="prefs-title" text="Make Vegas yours." />
                        <Label styleClass="aiv-subtitle" text="Tell us what you love. We'll find places that fit your trip." />
                     </children>
                  </VBox>

                  <!-- interests (pick as many as you like) -->
                  <VBox spacing="14.0">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="prefs-section-title" text="What brings you to Vegas?" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label styleClass="prefs-hint" text="Pick as many as you like" />
                           </children>
                        </HBox>
                        <HBox spacing="12.0">
                           <children>
                              <ToggleButton fx:id="diningToggle" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefWidth="0.0" styleClass="prefs-choice" text="Dining" HBox.hgrow="ALWAYS" />
                              <ToggleButton fx:id="entertainmentToggle" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefWidth="0.0" styleClass="prefs-choice" text="Entertainment" HBox.hgrow="ALWAYS" />
                              <ToggleButton fx:id="attractionsToggle" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefWidth="0.0" styleClass="prefs-choice" text="Attractions" HBox.hgrow="ALWAYS" />
                              <ToggleButton fx:id="casinosToggle" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefWidth="0.0" styleClass="prefs-choice" text="Casinos" HBox.hgrow="ALWAYS" />
                              <ToggleButton fx:id="hotelsToggle" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefWidth="0.0" styleClass="prefs-choice" text="Hotels" HBox.hgrow="ALWAYS" />
                              <ToggleButton fx:id="shoppingToggle" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefWidth="0.0" styleClass="prefs-choice" text="Shopping" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- daily budget (pick one) -->
                  <VBox spacing="10.0">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="prefs-section-title" text="Your daily budget" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label styleClass="prefs-hint" text="Per person · USD" />
                           </children>
                        </HBox>
                        <HBox spacing="16.0">
                           <fx:define>
                              <ToggleGroup fx:id="budgetGroup" />
                           </fx:define>
                           <children>
                              <ToggleButton contentDisplay="GRAPHIC_ONLY" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefWidth="0.0" styleClass="prefs-choice, prefs-budget" toggleGroup="$budgetGroup" userData="UNDER_150" HBox.hgrow="ALWAYS">
                                 <graphic>
                                    <VBox alignment="CENTER" spacing="3.0">
                                       <children>
                                          <Label styleClass="budget-range" text="Under $150" />
                                          <Label styleClass="budget-description" text="Keep it easy" />
                                       </children>
                                    </VBox>
                                 </graphic>
                              </ToggleButton>
                              <ToggleButton contentDisplay="GRAPHIC_ONLY" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefWidth="0.0" styleClass="prefs-choice, prefs-budget" toggleGroup="$budgetGroup" userData="150_300" HBox.hgrow="ALWAYS">
                                 <graphic>
                                    <VBox alignment="CENTER" spacing="3.0">
                                       <children>
                                          <Label styleClass="budget-range" text="\$150–$300" />
                                          <Label styleClass="budget-description" text="A little extra" />
                                       </children>
                                    </VBox>
                                 </graphic>
                              </ToggleButton>
                              <ToggleButton contentDisplay="GRAPHIC_ONLY" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefWidth="0.0" styleClass="prefs-choice, prefs-budget" toggleGroup="$budgetGroup" userData="OVER_300" HBox.hgrow="ALWAYS">
                                 <graphic>
                                    <VBox alignment="CENTER" spacing="3.0">
                                       <children>
                                          <Label styleClass="budget-range" text="\$300+" />
                                          <Label styleClass="budget-description" text="Go all out" />
                                       </children>
                                    </VBox>
                                 </graphic>
                              </ToggleButton>
                           </children>
                        </HBox>
                        <Label styleClass="prefs-hint" text="For dining, shows &amp; activities. Excludes stays and travel." />
                     </children>
                  </VBox>

                  <!-- party + dates -->
                  <HBox alignment="TOP_LEFT" spacing="48.0">
                     <children>

                        <!-- who's coming -->
                        <VBox prefWidth="0.0" spacing="10.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="prefs-section-title" text="Who's coming along?" />
                              <HBox spacing="16.0">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" prefWidth="0.0" styleClass="guest-counter" HBox.hgrow="ALWAYS">
                                       <children>
                                          <VBox spacing="2.0">
                                             <children>
                                                <Label styleClass="guest-label" text="Adults" />
                                                <Label styleClass="guest-age" text="Ages 18+" />
                                             </children>
                                          </VBox>
                                          <Region HBox.hgrow="ALWAYS" />
                                          <HBox alignment="CENTER" spacing="6.0">
                                             <children>
                                                <Button fx:id="adultsMinusButton" mnemonicParsing="false" onAction="#onAdultsMinusClicked" styleClass="stepper-button" text="−" />
                                                <Label fx:id="adultsValue" alignment="CENTER" minWidth="26.0" styleClass="stepper-value" text="2" />
                                                <Button fx:id="adultsPlusButton" mnemonicParsing="false" onAction="#onAdultsPlusClicked" styleClass="stepper-button" text="+" />
                                             </children>
                                          </HBox>
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" prefWidth="0.0" styleClass="guest-counter" HBox.hgrow="ALWAYS">
                                       <children>
                                          <VBox spacing="2.0">
                                             <children>
                                                <Label styleClass="guest-label" text="Children" />
                                                <Label styleClass="guest-age" text="Ages 0–17" />
                                             </children>
                                          </VBox>
                                          <Region HBox.hgrow="ALWAYS" />
                                          <HBox alignment="CENTER" spacing="6.0">
                                             <children>
                                                <Button fx:id="childrenMinusButton" mnemonicParsing="false" onAction="#onChildrenMinusClicked" styleClass="stepper-button" text="−" />
                                                <Label fx:id="childrenValue" alignment="CENTER" minWidth="26.0" styleClass="stepper-value" text="0" />
                                                <Button fx:id="childrenPlusButton" mnemonicParsing="false" onAction="#onChildrenPlusClicked" styleClass="stepper-button" text="+" />
                                             </children>
                                          </HBox>
                                       </children>
                                    </HBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <!-- dates -->
                        <VBox prefWidth="0.0" spacing="10.0" HBox.hgrow="ALWAYS">
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label styleClass="prefs-section-title" text="When are you visiting?" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label styleClass="prefs-hint" text="It's okay if you're not sure yet" />
                                 </children>
                              </HBox>
                              <HBox spacing="16.0">
                                 <children>
                                    <VBox prefWidth="0.0" spacing="7.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="date-label" text="Arrival" />
                                          <DatePicker fx:id="startDate" maxWidth="1.7976931348623157E308" promptText="Add arrival date" />
                                       </children>
                                    </VBox>
                                    <VBox prefWidth="0.0" spacing="7.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="date-label" text="Departure" />
                                          <DatePicker fx:id="endDate" maxWidth="1.7976931348623157E308" promptText="Add departure date" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- actions -->
                  <VBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Button fx:id="submitButton" mnemonicParsing="false" onAction="#onSubmitButtonClicked" prefWidth="320.0" styleClass="aiv-button-primary" defaultButton="true" text="Find my Vegas" />
                        <Button fx:id="skipButton" mnemonicParsing="false" onAction="#onSkipButtonClicked" styleClass="aiv-link" text="Skip for now — browse places" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>

   <!-- FOOTER -->
   <bottom>
      <VBox alignment="CENTER">
         <padding>
            <Insets bottom="42.0" top="20.0" />
         </padding>
         <children>
            <Label styleClass="prefs-reassurance" text="Your plans can change. Your preferences can, too." />
         </children>
      </VBox>
   </bottom>
</BorderPane>
